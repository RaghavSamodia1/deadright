node_modules/
.expo/
dist/
web-build/
*.log
.env
.env.local
.DS_Store
*.orig.*

# Native projects ARE committed: android/ carries the Kotlin 1.9.25 pin in
# build.gradle and the embedded fonts in app/src/main/assets/fonts, which a
# fresh `expo prebuild` would not reproduce. Ignore only build output.
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/local.properties
ios/build/
ios/Pods/

# Local Claude Code tool permissions (machine-specific)
.claude/

# Build output / CLI state
ios/build-device/
ios/build-signed/
supabase/.temp/

# Signing keys — never commit. The upload keystore and its passwords live
# outside the repo (~/.gradle/gradle.properties); losing them is unrecoverable
# without Play App Signing.
*.keystore
*.jks
!android/app/debug.keystore

# Iteration screenshots.
#
# Emulator frames are committed: they run on the demo account, so there is
# nothing in them but Test Mate and QRTest. Frames captured from a real phone
# are not — this repository is public and docs/ is its GitHub Pages source, so
# committing those would publish real people's names, handles and groups.
# Put device captures in a folder ending -phone and they stay out.
screenshots/*-phone/
