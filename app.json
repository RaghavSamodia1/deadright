{
  "expo": {
    "name": "DeadRight",
    "slug": "deadright",
    "scheme": "deadright",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0A0A0B",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.deadright.app",
      "infoPlist": {
        "NSCameraUsageDescription": "DeadRight uses the camera so you can snap photo evidence when settling or disputing a bet.",
        "NSPhotoLibraryUsageDescription": "DeadRight needs your photo library so you can attach evidence to a bet.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.deadright.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Barlow-SemiBold.ttf",
            "./assets/fonts/Barlow-Bold.ttf",
            "./assets/fonts/Barlow-Black.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/SpaceMono-Bold.ttf"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "DeadRight needs your photo library so you can attach evidence to a bet.",
          "cameraPermission": "DeadRight uses the camera so you can snap photo evidence when settling or disputing a bet."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "note": "Cred Score + Cookie Jar; no real money — ledger only."
    }
  }
}
